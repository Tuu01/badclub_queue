rules_version = '2';

// ============================================================
// firestore.rules
//
// PRINCIPLE:
//   READ — wide open. Paste the link into Zalo, anyone who opens it
//          can see it. This is how the app SPREADS through the group
//          without having to convince anyone.
//          An app that requires a code just to view it → nobody
//          views it, and if nobody views it, nobody uses it.
//
//   WRITE — NEVER from the client. Only via the Admin SDK
//           (server-side), which bypasses these rules entirely.
//
//   Why? If the client wrote directly: two phones could both grab An
//   and Binh for two different courts. The server has to be the referee.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- SESSION STATE: anyone can read ----------
    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if false;          // ← Admin SDK only

      match /games/{gameId} {
        allow read: if true;
        allow write: if false;
      }

      // Audit log: client CANNOT read it. Not needed, and it contains rating snapshots.
      match /audit/{logId} {
        allow read, write: if false;
      }
    }

    // ---------- CLUB ----------
    match /clubs/{clubId} {
      allow read: if true;
      allow write: if false;

      // Player list: readable (to show names).
      // BUT mu/sigma is sensitive data — rating is hidden for at least 3 months.
      // Solution: do NOT store mu/sigma in the doc the client reads.
      // They live in clubs/{cid}/private/ratings — the client never sees them.
      match /players/{playerId} {
        allow read: if true;
        allow write: if false;
      }

      // pairStats + ratings: server only. The client doesn't need them, and shouldn't see them.
      match /meta/{docId} {
        allow read, write: if false;
      }
      match /private/{docId} {
        allow read, write: if false;
      }
    }
  }
}

// ============================================================
// NOTE ON RATING
//
// SessionDoc.players[] contains mu/sigma (so suggestMatch can run
// server-side by reading just 1 doc). The client CAN READ that doc.
//
// → If you want to fully hide rating for the first 3 months, there
//   are 2 options:
//
//   A. Accept it. The rating is in the payload but the UI doesn't
//      show it. Only someone who opens DevTools would see it. Good
//      enough for a group of friends.
//
//   B. Split SessionDoc in two:
//        sessions/{sid}                 ← client reads (no mu/sigma)
//        sessions/{sid}/private/state   ← server only (has mu/sigma)
//      More correct, but the transaction has to touch 2 docs instead of 1.
//
// Recommendation: (A) for v1. Switch to (B) if someone pokes around in
// DevTools and makes noise about it — which is almost certainly NOT
// going to happen.
// ============================================================
